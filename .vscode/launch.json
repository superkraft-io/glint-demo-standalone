    // ── iOS Simulator ─────────────────────────────────────────────────────
    { "name": "📱 iOS Simulator" },

    {
      "name": "├─ 💽 Debug (Simulator)",
      "type": "lldb",
      "request": "attach",
      "targetCreateCommands": [
        "target create \"${workspaceFolder}/demo/build/ios-sim/Debug-iphonesimulator/glint_demo.app/glint_demo\""
      ],
      "processCreateCommands": [
        "platform select ios-simulator",
        "process attach --name glint_demo --waitfor"
